"""Small adapter-boundary declarations for pinned Backtrader 1.9.78.123.

Only callbacks we override are declared; metaclass-provided objects stay Any.
This is type metadata, not an implementation or replacement broker.
"""
from datetime import datetime
from typing import Any, ClassVar

Cerebro: Any
TimeFrame: Any
feeds: Any
ind: Any
__version__: str

def num2date(num: float) -> datetime: ...

class CommInfoBase:
    COMM_FIXED: ClassVar[int]
    params: Any
    p: Any
    def __init__(self, **kwargs: Any) -> None: ...
    def _getcommission(self, size: float, price: float, pseudoexec: bool) -> float: ...

class Strategy:
    params: Any
    p: Any
    datas: list[Any]
    broker: Any
    analyzers: Any
    def __init__(self, **kwargs: Any) -> None: ...
    def prenext(self) -> None: ...
    def prenext_open(self) -> None: ...
    def next_open(self) -> None: ...
    def next(self) -> None: ...
    def notify_order(self, order: Any) -> None: ...
    def notify_trade(self, trade: Any) -> None: ...
    def getposition(self, data: Any) -> Any: ...
    def buy(self, **kwargs: Any) -> Any: ...
    def sell(self, **kwargs: Any) -> Any: ...
    def close(self, **kwargs: Any) -> Any: ...
    def cancel(self, order: Any) -> None: ...

class Analyzer:
    p: Any
    strategy: Strategy
    def __init__(self, **kwargs: Any) -> None: ...
    def get_analysis(self) -> dict[Any, Any]: ...
    def stop(self) -> None: ...

class analyzers:
    class TimeReturn(Analyzer): ...
    class SharpeRatio(Analyzer):
        timereturn: analyzers.TimeReturn
    class DrawDown(Analyzer): ...
    class TradeAnalyzer(Analyzer): ...
